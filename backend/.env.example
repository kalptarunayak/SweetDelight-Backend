# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=
DB_USER=
DB_PASSWORD=

# Supabase Auth JWT Secret (used to validate incoming JWTs)
SUPABASE_JWT_SECRET=

# Server Port (Render sets this dynamically, default 8080)
PORT=8080

# Razorpay Test / Live Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cash on Delivery Flag (true / false)
COD_ENABLED=true

# Notification Settings
NOTIFY_MODE=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
ADMIN_WHATSAPP_NUMBER=

# OpenAPI / Swagger UI Toggle (true / false)
SWAGGER_ENABLED=true

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,https://your-github-username.github.io
